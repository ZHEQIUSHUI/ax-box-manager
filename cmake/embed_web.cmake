# 把 WEB_DIR 下的文件生成为 C++ 数组：cmake -DWEB_DIR=... -DOUT=... -P embed_web.cmake
file(GLOB_RECURSE files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT files)
set(body "")
set(table "")
set(i 0)
foreach(f IN LISTS files)
    file(READ "${WEB_DIR}/${f}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND body "static const unsigned char asset_${i}[] = {${hex}0x00};\n")
    string(APPEND table "    {\"${f}\", {asset_${i}, ${size}}},\n")
    math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// generated by cmake/embed_web.cmake, do not edit\n#include \"assets.hpp\"\n#include <map>\n\nnamespace axbox {\n\n${body}\nstd::optional<Asset> find_asset(const std::string& path) {\n    static const std::map<std::string, Asset> assets = {\n${table}    };\n    auto it = assets.find(path);\n    if (it == assets.end()) return std::nullopt;\n    return it->second;\n}\n\n}  // namespace axbox\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
